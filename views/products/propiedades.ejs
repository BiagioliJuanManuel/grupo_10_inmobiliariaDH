<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', {title: title}) %>


<body>
    <%- include('../partials/header') %>
    <main>
        <h1>Propiedades Listado</h1>
        <section class="section__propiedades flex">
            <% propiedades.forEach((propiedad) => { %>
                <article class="propiedad">
                    <div class="article__card">
                        <div class="article__title flex">
                            <h2><%= propiedad.category=='rent'? 'Alquiler' : 'Venta' %></h2><h2><%= propiedad.name %></h2>
                        </div>
                        <a href="/detalle/<%= propiedad.id %>" target="_blank" rel="noopener noreferrer">
                            <img src="<%= propiedad.images[0] %>" alt="">
                        </a>
    
                        <div class="article__subtitle flex">
                            <h3 class="subtitle__price">
                                <i class="bi bi-cash-coin"></i>
                                U$D <%= propiedad.price %>
                            </h3>
                            <div class="article__favorite">
                                <i class="bi bi-star"></i>
                            </div> 
                        </div>
                        <div class="article__location">
                            <h4><i class="bi bi-geo-alt"></i>
                              <%= propiedad.location %>
                            </h4>
                        </div>
                        <div class="article__features flex">
    
                            <ul>
                                <li><i class="bi bi-square"></i><%= propiedad.features.square_meters %> m2</li>
                                <li><i class="fa-solid fa-shower"></i> <%= propiedad.features.bathrooms %> baños</li> <!-- <i class="bi bi-badge-wc"></i> -->
                                <li><i class="bi bi-columns"></i><%= propiedad.features.rooms %> ambientes</li>
                                <li><i class="bi bi-door-open"></i><%= propiedad.features.bedrooms %> dormitorio</li>
                                <% if (propiedad.features.pool) { %>
                                    <li><i class="fa-solid fa-water-ladder"></i> pileta</li> <!-- icono Font Awesome -->
                                <% } %>
                                <% if (propiedad.features.courtyard) { %>
                                    <li><i class="bi bi-flower3"></i> patio</li>
                                <% } %>
                                <% if (propiedad.features.garages > 0) { %>
                                        <li><i class="bi bi-car-front-fill"></i> <%= propiedad.features.garages %> cochera</li>
                                <% } %>
                            </ul>
                        </div>
                    </div>
                    
                </article>
            <% }) %>
        
        </section>
    </main>

    <%- include('../partials/footer') %>

</body>


</html>