<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inmobiliaria DH</title>
    <link rel="stylesheet" href="/css/listado.css">
    <!-- <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"> -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">  <!-- Iconos Bootstrap -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
        rel="stylesheet">
</head>

<body>
    <%- include('../partials/header') %>
    <main>
        <h1>Propiedades Listado</h1>
        <section class="section__propiedades flex">
            <% propiedades.forEach((propiedad) => { %>
                <article class="propiedad">
                    <div class="article__card">
                        <div class="article__title flex">
                            <h2><%= propiedad.category=='rent'? 'Alquiler' : 'Venta' %></h2><h2><%= propiedad.name %></h2>
                        </div>
                        <a href="/detalle/<%= propiedad.id %>" target="_blank" rel="noopener noreferrer">
                            <img src="<%= propiedad.images[0] %>" alt="">
                        </a>
    
                        <div class="article__subtitle flex">
                            <h3 class="subtitle__price">
                                <i class="bi bi-cash-coin"></i>
                                U$D <%= propiedad.price %>
                            </h3>
                            <div class="article__favorite">
                                <i class="bi bi-star"></i>
                            </div> 
                        </div>
                        <div class="article__location">
                            <h4><i class="bi bi-geo-alt"></i>
                              <%= propiedad.location %>
                            </h4>
                        </div>
                        <div class="article__features flex">
    
                            <ul>
                                <li><i class="bi bi-square"></i><%= propiedad.features.square_meters %> m2</li>
                                <li><i class="fa-solid fa-shower"></i> <%= propiedad.features.bathrooms %> baños</li> <!-- <i class="bi bi-badge-wc"></i> -->
                                <li><i class="bi bi-columns"></i><%= propiedad.features.rooms %> ambientes</li>
                                <li><i class="bi bi-door-open"></i><%= propiedad.features.bedrooms %> dormitorio</li>
                                <% if (propiedad.features.pool) { %>
                                    <li><i class="fa-solid fa-water-ladder"></i> pileta</li> <!-- icono Font Awesome -->
                                <% } %>
                                <% if (propiedad.features.courtyard) { %>
                                    <li><i class="bi bi-flower3"></i> patio</li>
                                <% } %>
                                <% if (propiedad.features.garages > 0) { %>
                                        <li><i class="bi bi-car-front-fill"></i> <%= propiedad.features.garages %> cochera</li>
                                <% } %>
                            </ul>
                        </div>
                    </div>
                    
                </article>
            <% }) %>
        
        </section>
    </main>

    <%- include('../partials/footer') %>

</body>


</html>