<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', {title: title}) %>


<body>
    <%- include('../partials/header') %>
    <main>
        <section class="section__propiedades flex">
            <article class="propiedad__formulario">
                    <form action="/" method="get" class="formulario">
                        <h2>Creacion/Edicion</h2>
                        <div class="formulario__label">
                            <!-- <label for="nombre">Nombre y apellido:</label> -->
                            <input type="text" id="nombre" name="nombre"  placeholder="Titulo de Propiedad" required>
                            <span class="error-message"><i class="fa-solid fa-circle-exclamation"></i>Este campo es obligatorio.</span>
                        </div>
                        <div class="formulario__label">
                            <label for="foto">Imagenes de la Propiedad:</label>
                            <input type="file" id="foto" name="foto" accept="image/*">
                        </div>
                        <div class="formulario__label">
                            <!-- <label for="usuario">Precio:</label> -->
                            <input type="text" id="usuario" name="usuario" placeholder="Precio" required>
                            <span class="error-message"><i class="fa-solid fa-circle-exclamation"></i>Este campo es obligatorio.</span>
                        </div>
                        <div class="formulario__label">
                            <!-- <label for="email">Locacion:</label> -->
                            <input type="email" id="email" name="email" placeholder="Locación" required>
                            <span class="error-message"><i class="fa-solid fa-circle-exclamation"></i>Este campo es obligatorio.</span>
                        </div>
                        <div class="formulario__label">
                            <!-- <label for="domicilio">Domicilio:</label> -->
                            <input type="text" id="domicilio" name="domicilio" placeholder="Domicilio" required>
                            <span class="error-message"><i class="fa-solid fa-circle-exclamation"></i>Este campo es obligatorio.</span>
                        </div>

                        <div class="formulario__label">
                            <h3>Caracteristicas:</h3>
                            <label for="metrosCuadrados">
                                <input type="text" id="metrosCuadrados" name="metrosCuadrados" placeholder="metros cuadrados" required>
                            </label>
                            <label for="Patio">
                                <input type="checkbox" id="patio" name="Caracteristicas" value="Patio">
                                Patio
                            </label>
                            <label for="cochera">
                                <input type="checkbox" id="cochera" name="Caracteristicas" value="cochera">
                                cochera
                            </label>
                            <label for="mascotas">
                                <input type="checkbox" id="mascotas" name="caracteristicas" value="mascotas">
                                mascotas
                            </label>
                            <label for="vidaSana">
                                <input type="checkbox" id="vidaSana" name="caracteristicas" value="Pileta">
                                Pileta
                            </label>
                        </div>

                        <div class="formulario__label">
                            <h3>Categoria de Inmuebles:</h3>
                            <label for="Categoria">
                                <input type="radio" id="Categoria" name="Categoria" value="Venta">
                                Venta
                                <input type="radio" id="Categoria" name="Categoria" value="Alquiler">
                                Alquiler
                            </label>
                            <label for="CategoriaSecundaria">
                                <input type="checkbox" id="Residencial" name="Residencial" value="Residencial">
                                Residencial
                            </label>
                            <label for="CategoriaSecundaria">
                                <input type="checkbox" id="Comercial" name="Comercial" value="Comercial">
                                Comercial
                            </label>
                            <label for="CategoriaSecundaria">
                                <input type="checkbox" id="Emprendimiento" name="Emprendimiento" value="Emprendimiento">
                                Emprendimiento
                            </label>                            
                        </div>
            </article>        
        </section>
    </main>

    <%- include('../partials/footer') %>

</body>


</html>